// # Big Matrix Digits - Block Character Glyph Font
//
// Logline: Generates 5-row tall block character glyphs for digital matrix clock display.
//
// Setup: Pure character glyph matrix generator. Zero ambient authority.
//
// Beats:
//   1. Define 5-row matrix slices for decimal numerals 0 through 9.
//   2. Define blinking separator colon glyphs.
//   3. Render arbitrary composite time strings into formatted multi-line matrix text.

pub fn get_digit_slice(d: Int, row: Int) -> String {
    if d == 0 {
        if row == 0 || row == 4 { return "████"; }
        return "█  █";
    }
    if d == 1 {
        if row == 0 { return "  ██"; }
        if row == 4 { return " ███"; }
        return "   █";
    }
    if d == 2 {
        if row == 0 || row == 2 || row == 4 { return "████"; }
        if row == 1 { return "   █"; }
        return "█   ";
    }
    if d == 3 {
        if row == 0 || row == 4 { return "████"; }
        if row == 2 { return " ███"; }
        return "   █";
    }
    if d == 4 {
        if row == 0 || row == 1 { return "█  █"; }
        if row == 2 { return "████"; }
        return "   █";
    }
    if d == 5 {
        if row == 0 || row == 2 || row == 4 { return "████"; }
        if row == 1 { return "█   "; }
        return "   █";
    }
    if d == 6 {
        if row == 0 || row == 2 || row == 4 { return "████"; }
        if row == 1 { return "█   "; }
        return "█  █";
    }
    if d == 7 {
        if row == 0 { return "████"; }
        if row == 1 { return "   █"; }
        if row == 2 { return "  █ "; }
        return " █  ";
    }
    if d == 8 {
        if row == 0 || row == 2 || row == 4 { return "████"; }
        return "█  █";
    }
    if d == 9 {
        if row == 0 || row == 2 || row == 4 { return "████"; }
        if row == 1 { return "█  █"; }
        return "   █";
    }
    return "    ";
}

pub fn get_colon_slice(row: Int) -> String {
    if row == 1 || row == 3 { return " ● "; }
    return "   ";
}

fn digit_from_char(c: String) -> Int {
    if c == "0" { return 0; }
    if c == "1" { return 1; }
    if c == "2" { return 2; }
    if c == "3" { return 3; }
    if c == "4" { return 4; }
    if c == "5" { return 5; }
    if c == "6" { return 6; }
    if c == "7" { return 7; }
    if c == "8" { return 8; }
    if c == "9" { return 9; }
    return -1;
}

pub fn render_time_matrix_row(time_str: String, row: Int) -> String {
    let mut out: String = "";
    let n: Int = chars_len(time_str);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(time_str, i);
        if c == ":" {
            out = out + get_colon_slice(row);
        } else {
            let d: Int = digit_from_char(c);
            out = out + get_digit_slice(d, row) + " ";
        }
        i = i + 1;
    }
    return out;
}
