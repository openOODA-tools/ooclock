// # Time Mathematics - Epoch Breakdown and Formatting
//
// Logline: Converts epoch milliseconds into human hours, minutes, seconds, and durations.
//
// Setup: Pure arithmetic conversions. Zero ambient authority.
//
// Beats:
//   1. Decompose epoch milliseconds into TimeComponents.
//   2. Format two-digit padded numbers for HH:MM:SS clock readouts.
//   3. Format stopwatch elapsed time with millisecond precision.

pub type TimeComponents = struct {
    hours: Int,
    minutes: Int,
    seconds: Int,
    millis: Int
};

pub fn pad_two(n: Int) -> String {
    let s: String = to_string(n);
    if chars_len(s) < 2 {
        return "0" + s;
    }
    return s;
}

pub fn epoch_to_components(epoch_ms: Int, tz_offset_hours: Int) -> TimeComponents {
    let total_secs: Int = epoch_ms / 1000;
    let millis: Int = epoch_ms % 1000;
    let sec: Int = total_secs % 60;
    let total_mins: Int = total_secs / 60;
    let min: Int = total_mins % 60;
    let total_hrs: Int = (total_mins / 60) + tz_offset_hours;
    let mut hr: Int = total_hrs % 24;
    if hr < 0 { hr = hr + 24; }
    return TimeComponents {
        hours: hr,
        minutes: min,
        seconds: sec,
        millis: millis
    };
}

pub fn format_clock_string(tc: TimeComponents) -> String {
    return pad_two(tc.hours) + ":" + pad_two(tc.minutes) + ":" + pad_two(tc.seconds);
}

pub fn format_stopwatch_string(elapsed_ms: Int) -> String {
    let total_secs: Int = elapsed_ms / 1000;
    let rem_ms: Int = (elapsed_ms % 1000) / 10;
    let sec: Int = total_secs % 60;
    let total_mins: Int = total_secs / 60;
    let min: Int = total_mins % 60;
    let hr: Int = total_mins / 60;
    let ms_str: String = pad_two(rem_ms);
    if hr > 0 {
        return pad_two(hr) + ":" + pad_two(min) + ":" + pad_two(sec) + "." + ms_str;
    }
    return pad_two(min) + ":" + pad_two(sec) + "." + ms_str;
}
